@startuml modelo_relacional_classia
!theme plain

skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam roundcorner 8
skinparam defaultFontName 'Segoe UI', 'Helvetica', 'Arial', sans-serif
skinparam defaultFontSize 10
skinparam defaultFontColor #2D3748

skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #3182CE
    BorderColor #2B6CB0
    HeaderBackgroundColor #EBF8FF
    FontStyle bold
}

hide methods
hide stereotypes

title Modelo Relacional — Classia (Sprint 4 - Consolidación Final)

' ─────────────────────────────────────────────
' TABLAS
' ─────────────────────────────────────────────

class roles << (T,#EBF8FF) >> {
  <u>id_rol INT PK</u>
  nombre_rol VARCHAR(50) UNIQUE
  descripcion VARCHAR(255)
}

class usuarios << (T,#EBF8FF) >> {
  <u>id_usuario INT PK</u>
  nombre VARCHAR(100)
  apellido VARCHAR(100)
  cedula_identidad VARCHAR(255)
  cedula_hash VARCHAR(64) UNIQUE
  email VARCHAR(150) UNIQUE
  password_hash VARCHAR(255)
  telefono VARCHAR(30)
  fecha_registro DATETIME
  foto_perfil VARCHAR(255)
  github_id VARCHAR(100) UNIQUE
  nombre_usuario VARCHAR(30) UNIQUE
  genero VARCHAR(30)
  dos_factores_activo TINYINT(1)
  dos_factores_secreto VARCHAR(255)
  dos_factores_backup_codes TEXT
  email_verificado TINYINT(1)
  email_verificacion_token CHAR(64)
  email_verificacion_expira DATETIME
  onboarding_step TINYINT UNSIGNED
  onboarding_data TEXT
  fecha_nacimiento DATE
  datos_cambiados_en DATETIME
  nuevo_email_pendiente VARCHAR(150)
  nuevo_email_token CHAR(64)
  nuevo_email_expira DATETIME
  password_reset_token CHAR(64)
  password_reset_expira DATETIME
  activo TINYINT(1)
  fecha_baja DATETIME
  motivo_bloqueo TEXT
  <i>id_rol INT FK → roles.id_rol</i>
}

class perfiles_profesionales << (T,#EBF8FF) >> {
  <u>id_perfil INT PK</u>
  titulo_profesional VARCHAR(180)
  presentacion TEXT
  experiencia TEXT
  formacion TEXT
  certificaciones TEXT
  habilidades TEXT
  especialidades TEXT
  idiomas VARCHAR(255)
  ubicacion VARCHAR(150)
  modalidad_trabajo VARCHAR(150)
  portfolio_url VARCHAR(255)
  linkedin_url VARCHAR(255)
  tiempo_respuesta VARCHAR(100)
  visibilidad ENUM
  actualizado_en DATETIME
  <i>id_usuario INT FK → usuarios.id_usuario UNIQUE</i>
}

class notificaciones << (T,#EBF8FF) >> {
  <u>id_notificacion INT PK</u>
  categoria VARCHAR(60)
  titulo VARCHAR(180)
  mensaje TEXT
  url_destino VARCHAR(500)
  tipo_entidad VARCHAR(80)
  id_entidad INT
  leida TINYINT(1)
  fecha_creacion DATETIME
  fecha_leida DATETIME
  clave_idempotencia VARCHAR(64)
  <i>id_usuario INT FK → usuarios.id_usuario</i>
}

class categorias << (T,#EBF8FF) >> {
  <u>id_categoria INT PK</u>
  nombre_categoria VARCHAR(100) UNIQUE
  descripcion TEXT
  <i>creada_por INT FK → usuarios.id_usuario</i>
}

class publicaciones << (T,#EBF8FF) >> {
  <u>id_publicacion INT PK</u>
  titulo VARCHAR(200)
  descripcion TEXT
  precio DECIMAL(10,2)
  tipo ENUM('Curso','Servicio')
  modalidad VARCHAR(30)
  nivel_experiencia VARCHAR(30)
  duracion_horas SMALLINT UNSIGNED
  cupos INT
  disponibilidad TEXT
  tipo_servicio VARCHAR(60)
  estado ENUM
  imagen VARCHAR(255)
  eliminado_en DATETIME
  fecha_creacion DATETIME
  fecha_actualizacion DATETIME
  porcentaje_minimo_aprobacion TINYINT UNSIGNED
  <i>id_usuario INT FK → usuarios.id_usuario</i>
  <i>id_categoria INT FK → categorias.id_categoria</i>
}

class publicacion_visitas << (T,#EBF8FF) >> {
  <u>id_visita INT PK</u>
  fecha_visita DATE
  visitas INT UNSIGNED
  <i>id_publicacion INT FK → publicaciones.id_publicacion UNIQUE(id_pub,fecha)</i>
}

class curso_modulos << (T,#EBF8FF) >> {
  <u>id_modulo INT PK</u>
  titulo VARCHAR(180)
  descripcion TEXT
  orden INT
  visible_alumnos TINYINT(1)
  <i>id_publicacion INT FK → publicaciones.id_publicacion</i>
}

class curso_unidades << (T,#EBF8FF) >> {
  <u>id_unidad INT PK</u>
  titulo VARCHAR(180)
  descripcion TEXT
  orden INT
  <i>id_modulo INT FK → curso_modulos.id_modulo</i>
}

class curso_recursos << (T,#EBF8FF) >> {
  <u>id_recurso INT PK</u>
  titulo VARCHAR(180)
  tipo ENUM
  url VARCHAR(500)
  archivo VARCHAR(255)
  descripcion TEXT
  orden INT
  fecha_creacion DATETIME
  visible_alumnos TINYINT(1)
  <i>id_unidad INT FK → curso_unidades.id_unidad</i>
}

class curso_recursos_completados << (T,#EBF8FF) >> {
  <u>id_completado INT PK</u>
  fecha_completado DATETIME
  <i>id_usuario INT FK → usuarios.id_usuario</i>
  <i>id_recurso INT FK → curso_recursos.id_recurso</i>
  UNIQUE(id_usuario, id_recurso)
}

class curso_tareas << (T,#EBF8FF) >> {
  <u>id_tarea INT PK</u>
  fecha_apertura DATETIME
  fecha_cierre DATETIME
  permite_archivos TINYINT(1)
  permite_texto TINYINT(1)
  permite_enlace TINYINT(1)
  max_archivos INT
  max_tamano_mb INT
  formatos_permitidos JSON
  requisito_entrega ENUM
  puntaje_maximo DECIMAL(8,2)
  tipo_calificacion ENUM
  permite_feedback_archivo TINYINT(1)
  fecha_creacion DATETIME
  fecha_actualizacion DATETIME
  <i>id_recurso INT FK → curso_recursos.id_recurso UNIQUE</i>
}

class curso_entregas << (T,#EBF8FF) >> {
  <u>id_entrega INT PK</u>
  archivo_entrega VARCHAR(500)
  texto_entrega TEXT
  enlace_entrega VARCHAR(500)
  comentario_entrega TEXT
  estado ENUM('Entregada','Calificada')
  estado_entrega ENUM('borrador','entregada')
  calificacion VARCHAR(30)
  feedback_docente TEXT
  archivo_feedback VARCHAR(500)
  fecha_calificacion DATETIME
  id_docente_calificador INT
  fecha_entrega DATETIME
  fecha_actualizacion DATETIME
  <i>id_tarea INT FK → curso_tareas.id_tarea</i>
  <i>id_recurso INT FK → curso_recursos.id_recurso</i>
  <i>id_usuario INT FK → usuarios.id_usuario</i>
  UNIQUE(id_recurso, id_usuario)
}

class curso_entrega_archivos << (T,#EBF8FF) >> {
  <u>id_archivo INT PK</u>
  nombre_original VARCHAR(255)
  ruta VARCHAR(500)
  mime_type VARCHAR(120)
  extension VARCHAR(20)
  tamano BIGINT
  fecha_subida DATETIME
  <i>id_entrega INT FK → curso_entregas.id_entrega</i>
}

class curso_foro_mensajes << (T,#EBF8FF) >> {
  <u>id_mensaje INT PK</u>
  mensaje TEXT
  fecha_mensaje DATETIME
  <i>id_recurso INT FK → curso_recursos.id_recurso</i>
  <i>id_usuario INT FK → usuarios.id_usuario</i>
}

class certificados << (T,#EBF8FF) >> {
  <u>id_certificado INT PK</u>
  codigo_verificacion VARCHAR(32) UNIQUE
  fecha_emision DATETIME
  porcentaje_aprobacion DECIMAL(5,2)
  <i>id_usuario INT FK → usuarios.id_usuario</i>
  <i>id_curso INT FK → publicaciones.id_publicacion</i>
  UNIQUE(id_usuario, id_curso)
}

class solicitudes << (T,#EBF8FF) >> {
  <u>id_solicitud INT PK</u>
  titulo VARCHAR(200)
  descripcion TEXT
  estado ENUM
  detalles_json JSON
  archivo_adjunto VARCHAR(255)
  precio_propuesto DECIMAL(10,2)
  fecha_hora_propuesta DATETIME
  respuesta_proveedor TEXT
  fecha_solicitud DATETIME
  fecha_actualizacion DATETIME
  <i>id_usuario INT FK → usuarios.id_usuario</i>
  <i>id_publicacion INT FK → publicaciones.id_publicacion</i>
  <i>id_contratacion INT FK → contrataciones.id_contratacion</i>
}

class solicitud_mensajes << (T,#EBF8FF) >> {
  <u>id_mensaje INT PK</u>
  mensaje TEXT
  fecha_mensaje DATETIME
  <i>id_solicitud INT FK → solicitudes.id_solicitud</i>
  <i>id_usuario INT FK → usuarios.id_usuario</i>
}

class solicitudes_docente << (T,#EBF8FF) >> {
  <u>id_solicitud_docente INT PK</u>
  estado ENUM('Pendiente','Aprobada','Rechazada')
  motivo TEXT
  documentacion_ruta VARCHAR(500)
  documentacion_nombre VARCHAR(255)
  documentacion_mime VARCHAR(100)
  documentacion_tamano INT UNSIGNED
  documentacion_fecha DATETIME
  fecha_solicitud DATETIME
  fecha_respuesta DATETIME
  <i>id_usuario INT FK → usuarios.id_usuario</i>
}

class contrataciones << (T,#EBF8FF) >> {
  <u>id_contratacion INT PK</u>
  fecha_contratacion DATETIME
  monto_total DECIMAL(10,2)
  estado ENUM('Pendiente','En Proceso','Completada','Cancelada')
  <i>id_usuario INT FK → usuarios.id_usuario</i>
}

class detalles_contratacion << (T,#EBF8FF) >> {
  <u>id_detalle INT PK</u>
  cantidad INT
  precio_unitario DECIMAL(10,2)
  subtotal DECIMAL(10,2)
  <i>id_contratacion INT FK → contrataciones.id_contratacion</i>
  <i>id_publicacion INT FK → publicaciones.id_publicacion</i>
}

class pagos << (T,#EBF8FF) >> {
  <u>id_pago INT PK</u>
  monto DECIMAL(10,2)
  metodo_pago ENUM('Tarjeta','Transferencia','MercadoPago','Efectivo')
  estado_pago ENUM('Pendiente','Aprobado','Rechazado')
  fecha_pago DATETIME
  transaccion_ref VARCHAR(100)
  <i>id_contratacion INT FK → contrataciones.id_contratacion</i>
}

class valoraciones << (T,#EBF8FF) >> {
  <u>id_valoracion INT PK</u>
  puntuacion INT CHECK(1..5)
  comentario TEXT
  fecha_valoracion DATETIME
  <i>id_usuario INT FK → usuarios.id_usuario</i>
  <i>id_publicacion INT FK → publicaciones.id_publicacion</i>
  <i>id_contratacion INT FK → contrataciones.id_contratacion</i>
}

class eventos << (T,#EBF8FF) >> {
  <u>id_evento INT PK</u>
  titulo VARCHAR(255)
  descripcion TEXT
  tipo VARCHAR(100)
  modalidad VARCHAR(50)
  fecha_evento DATETIME
  ubicacion_enlace VARCHAR(255)
  cupos INT
  imagen VARCHAR(255)
  estado VARCHAR(50)
  id_usuario INT
}

class noticias << (T,#EBF8FF) >> {
  <u>id_noticia INT PK</u>
  titulo VARCHAR(255)
  subtitulo VARCHAR(255)
  cuerpo TEXT
  imagen VARCHAR(255)
  categoria VARCHAR(100)
  autor VARCHAR(100)
  fecha_publicacion DATETIME
  orden INT
  estado VARCHAR(50)
  id_usuario INT
}

' ─────────────────────────────────────────────
' RELACIONES (FK arrows)
' ─────────────────────────────────────────────

roles "1" --o{ "0..*" usuarios

usuarios "1" --o| "0..1" perfiles_profesionales
usuarios "1" --o{ "0..*" notificaciones
usuarios "1" --o{ "0..*" publicaciones
usuarios "1" --o{ "0..*" contrataciones
usuarios "1" --o{ "0..*" solicitudes
usuarios "1" --o{ "0..*" solicitudes_docente
usuarios "1" --o{ "0..*" valoraciones
usuarios "1" --o{ "0..*" certificados
usuarios "1" --o{ "0..*" curso_entregas
usuarios "1" --o{ "0..*" curso_foro_mensajes
usuarios "1" --o{ "0..*" solicitud_mensajes
usuarios "1" --o{ "0..*" curso_recursos_completados

categorias "1" --o{ "0..*" publicaciones
categorias }o--o| "0..1" usuarios : "creada_por"

publicaciones "1" --o{ "0..*" publicacion_visitas
publicaciones "1" --o{ "0..*" curso_modulos
publicaciones "1" --o{ "0..*" certificados
publicaciones "1" --o{ "0..*" solicitudes
publicaciones "1" --o{ "0..*" detalles_contratacion
publicaciones "1" --o{ "0..*" valoraciones

curso_modulos "1" --o{ "0..*" curso_unidades
curso_unidades "1" --o{ "0..*" curso_recursos

curso_recursos "1" --o| "0..1" curso_tareas
curso_recursos "1" --o{ "0..*" curso_entregas
curso_recursos "1" --o{ "0..*" curso_foro_mensajes
curso_recursos "1" --o{ "0..*" curso_recursos_completados

curso_tareas "1" --o{ "0..*" curso_entregas
curso_entregas "1" --o{ "0..*" curso_entrega_archivos

contrataciones "1" --o{ "0..*" pagos
contrataciones "1" --o{ "0..*" detalles_contratacion
contrataciones "1" --o{ "0..*" valoraciones
contrataciones "1" --o{ "0..*" solicitudes

solicitudes "1" --o{ "0..*" solicitud_mensajes

@enduml
