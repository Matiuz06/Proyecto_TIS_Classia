@startuml casos_de_uso_general
!theme plain

skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam roundcorner 8
skinparam defaultFontName 'Segoe UI', 'Helvetica', 'Arial', sans-serif
skinparam defaultFontSize 12
skinparam defaultFontColor #2D3748

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #3182CE
    ActorBorderColor #2B6CB0
    ActorBackgroundColor #EBF8FF
}

title Diagrama General de Casos de Uso — Classia (Sprint 4 - Consolidación Final)

left to right direction

actor "Visitante" as Visitante
actor "Estudiante / Cliente" as Estudiante
actor "Docente / Proveedor" as Docente
actor "Administrador" as Admin

rectangle "Sistema Classia — Aula Virtual y Servicios" {
  ' Visitante / Común
  usecase "Registrarse en Plataforma" as UC_Reg
  usecase "Iniciar Sesión y 2FA" as UC_Login
  usecase "Explorar Catálogo y Filtros" as UC_Cat
  usecase "Ver Detalle de Oferta" as UC_Det
  usecase "Verificar Certificado Público" as UC_VerifCert

  ' Estudiante
  usecase "Inscribirse y Realizar Pago" as UC_Pay
  usecase "Acceder a Clases y Recursos" as UC_Clases
  usecase "Enviar Entregas de Tareas" as UC_Entregas
  usecase "Descargar Certificado Aprobado" as UC_Cert
  usecase "Participar en Foros del Curso" as UC_Foro
  usecase "Solicitar y Chatear por Servicios" as UC_Sol
  usecase "Calificar Cursos con Reseñas" as UC_Val

  ' Docente
  usecase "Publicar y Editar Cursos/Servicios" as UC_Pub
  usecase "Gestionar Módulos y Recursos" as UC_Cont
  usecase "Configurar Tareas de Evaluación" as UC_ConfTareas
  usecase "Calificar Entregas y Feedback" as UC_Calif
  usecase "Gestionar Perfil Profesional" as UC_Perf
  usecase "Responder Solicitudes de Servicio" as UC_RespSol

  ' Administrador
  usecase "Supervisar Usuarios y Métricas" as UC_Adm
  usecase "Moderar Solicitudes Rol Docente" as UC_ApprDoc
  usecase "Moderar Publicaciones y Contenidos" as UC_ModPub
}

Visitante --> UC_Reg
Visitante --> UC_Login
Visitante --> UC_Cat
Visitante --> UC_Det
Visitante --> UC_VerifCert

Estudiante --|> Visitante
Estudiante --> UC_Pay
Estudiante --> UC_Clases
Estudiante --> UC_Entregas
Estudiante --> UC_Cert
Estudiante --> UC_Foro
Estudiante --> UC_Sol
Estudiante --> UC_Val

Docente --|> Visitante
Docente --> UC_Pub
Docente --> UC_Cont
Docente --> UC_ConfTareas
Docente --> UC_Calif
Docente --> UC_Perf
Docente --> UC_RespSol

Admin --|> Visitante
Admin --> UC_Adm
Admin --> UC_ApprDoc
Admin --> UC_ModPub
@enduml
