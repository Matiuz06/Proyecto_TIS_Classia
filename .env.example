
#Para usar una conexión se debe de comentar la otra (Opción 1 o opción 2)

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (Classia)
# ==============================================================================
# Opción 1: Conexión a SUPABASE (PostgreSQL Remoto / Producción)
# Obtener en https://supabase.com/dashboard/project/_/settings/database
# DB_DRIVER=pgsql
# DB_HOST=aws-0-sa-east-1.pooler.supabase.com  # o db.[tu-ref].supabase.co
# DB_PORT=6543                                 # 6543 (Transaction Pooler) o 5432 (Directo)
# DB_NAME=postgres
# DB_USER=postgres.tu_id_de_proyecto          # o postgres para conexión directa
# DB_PASSWORD=tu_password_de_supabase_db
# DB_SSLMODE=require

# Opción 2: Conexión LOCAL (MySQL / MariaDB por defecto)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=classia_db
DB_USER=classia_user
DB_PASSWORD=CONTRASENA_LOCAL


# Google OAuth 2.0 — Obtener en https://console.cloud.google.com/
# Tipo: Web application | Authorized redirect URI: http://localhost:8080/php/auth/callback_oauth_google.php
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/php/auth/callback_oauth_google.php

# GitHub OAuth 2.0 — Obtener en https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/php/auth/callback_oauth_github.php
GITHUB_CLIENT_ID=TU_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=TU_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://localhost:8080/php/auth/callback_oauth_github.php

# Google reCAPTCHA v2 / v3 — Obtener en https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=TU_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=TU_RECAPTCHA_SECRET_KEY

# Configuracion SMTP
MAIL_TO=anitechsa2026@gmail.com
APP_URL=http://localhost:8080
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Classia

# SMTP_SECURE acepta: tls, ssl, none.
# Para cualquier proveedor SMTP, reemplazar los valores SMTP_* anteriores.

# Supabase Storage (Almacenamiento de archivos y recursos de cursos)
# Obtener credenciales en https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica
SUPABASE_SERVICE_KEY=tu-clave-service-role-secreta
SUPABASE_BUCKET=recursos-cursos
SUPABASE_ACTIVO=false
